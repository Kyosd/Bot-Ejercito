# ========================================================
# CONFIGURACIÓN PRINCIPAL DE DISCORD
# ========================================================

CLIENT_ID=
GUILD_ID=

# ========================================================
# BASE DE DATOS (PERSISTENCIA INDESTRUCTIBLE)
# ========================================================
# En Railway: Añade una base de datos PostgreSQL desde tu proyecto
# y Railway creará automáticamente esta variable DATABASE_URL.
# Si está vacía, el bot funcionará en SQLite local (./data/database.sqlite).
DATABASE_URL=
DATABASE_SSL=

# ========================================================
# ROLES Y USUARIOS DE ALTO MANDO / GENERALES
# (IDs separados por coma: usuarios o roles)
# ========================================================
GENERALS_IDS=

# ========================================================
# CANALES DEL SERVIDOR (OPCIONAL: POR DEFECTO YA TIENEN VALORES)
# ========================================================
CHANNEL_PRINCIPAL=
CHANNEL_LIVE_STATUS=
CHANNEL_REPORT=
CHANNEL_LOGS=
CHANNEL_SANCTIONS=
CHANNEL_SANCTIONS_LOGS=
CHANNEL_AUDIT=

# ========================================================
# SISTEMA DE TICKETS
# ========================================================
# ID de la categoría de Discord donde se crearán los canales de tickets
TICKETS_CATEGORY_ID=
# Canal donde se envían las transcripciones completas al cerrar un ticket
TICKETS_TRANSCRIPTS_CHANNEL=

# ========================================================
# INTENTS (Portal de Discord → Bot)
# ========================================================
# Activa MESSAGE CONTENT INTENT (Privileged) o las transcripciones
# no podrán leer el texto de los usuarios, solo el del bot.
# Activa SERVER MEMBERS INTENT para apodos y roles de verificación.

# ========================================================
# VERIFICACIÓN
# ========================================================
# Canal donde el Alto Mando ve las solicitudes
CHANNEL_VERIFICATION=
# Canal del botón "Verificarme" (si vacío, usa CHANNEL_PRINCIPAL)
CHANNEL_VERIFICATION_PANEL=
# Roles que se entregan al aprobar (IDs separados por coma)
VERIFIED_ROLE_IDS=
# Roles que se quitan al aprobar (opcional)
UNVERIFIED_ROLE_IDS=
DEFAULT_VERIFY_RANK=Recluta
DEFAULT_VERIFY_DIVISION=Infantería

# ========================================================
# ARRESTOS
# ========================================================
CHANNEL_ARRESTS=

# ==============================================================================
# 🤖 1. CONEXIÓN Y SERVIDOR DE DISCORD
# ==============================================================================
# Token secreto de tu bot (Discord Developer Portal -> Applications -> Bot -> Token)
DISCORD_TOKEN=

# ID de la aplicación del bot (General Information -> Application ID)
CLIENT_ID=

# ID del servidor de Discord de la unidad militar
GUILD_ID=


# ==============================================================================
# 🗄️ 2. BASE DE DATOS (PERSISTENCIA INDESTRUCTIBLE)
# ==============================================================================
# En Railway: Añade una base de datos PostgreSQL y pega aquí la variable DATABASE_URL.
# Si está vacía, el bot guardará automáticamente todo en SQLite local (./data/database.sqlite).
DATABASE_URL=
DATABASE_SSL=false


# ==============================================================================
# 🎖️ 3. ALTO MANDO / MANDOS AUTORIZADOS
# ==============================================================================
# IDs de roles o usuarios autorizados como Mando / Generales (separados por coma).
# Tienen acceso a sanciones, reportes, gestión de ausencias y administración general.
GENERALS_IDS=


# ==============================================================================
# ⏱️ 4. CONTROL DE SERVICIO Y HORAS DE GUARDIA
# ==============================================================================
# Canal donde se publica y mantiene el panel de servicio en vivo (Botones: Entrar, Pausa, Salir, Mando)
CHANNEL_HOURS_PANEL=

# Canal secundario para la lista de personal activo en tiempo real (si está vacío, usa el panel de horas)
CHANNEL_HOURS_LIVE_STATUS=

# Canal oficial donde se envía el CIERRE SEMANAL INTEGRAL (Horas, Arrestos, Suministros, Sanciones, Ausencias)
CHANNEL_WEEKLY_CLOSING=


# ==============================================================================
# 📜 5. AUDITORÍA, LOGS Y COPIAS DE SEGURIDAD
# ==============================================================================
# Canal donde se registran los eventos de servicio (entradas, pausas, salidas de guardia)
CHANNEL_LOGS=

# Canal privado donde se envían las copias de seguridad automáticas semanales (Backups JSON)
CHANNEL_AUDIT_BACKUPS=


# ==============================================================================
# 🛡️ 6. VERIFICACIÓN Y REGISTRO DE IDENTIDAD MILITAR
# ==============================================================================
# Canal público donde se ubica el panel con el botón "Verificarme" para el personal
CHANNEL_VERIFY_PANEL=

# Canal privado del Alto Mando donde llegan las solicitudes para Aprobar o Rechazar
CHANNEL_VERIFY_REQUESTS=

# IDs de los roles de Discord que se entregan al soldado al ser verificado (separados por coma)
VERIFIED_ROLE_IDS=

# IDs de roles que se retiran al soldado al verificarse (ej: Civil / No Verificado, separados por coma)
UNVERIFIED_ROLE_IDS=

# Rango inicial por defecto si el soldado no tiene roles militares asignados
DEFAULT_VERIFY_RANK=Recluta

# División por defecto asignada al verificarse
DEFAULT_VERIFY_DIVISION=Infantería


# ==============================================================================
# 🚨 7. PROCEDIMIENTOS DE ARRESTO CIVIL
# ==============================================================================
# Canal oficial donde se publican las actas y evidencias de arrestos a civiles infractores
CHANNEL_ARRESTS=


# ==============================================================================
# 📦 8. SUMINISTROS Y LOGÍSTICA DE PATRULLAS
# ==============================================================================
# Canal oficial donde se publican los abastecimientos realizados (si vacío, se envía en el canal del comando)
CHANNEL_SUPPLIES=


# ==============================================================================
# ⚖️ 9. RÉGIMEN DISCIPLINARIO Y SANCIONES
# ==============================================================================
# Canal oficial donde se publican las sanciones militares y reportes de Corte Marcial
CHANNEL_SANCTIONS=

# Canal interno de auditoría para el historial de sanciones, reseteos y advertencias
CHANNEL_SANCTIONS_LOGS=


# ==============================================================================
# 📋 10. CENSO DE AUSENCIAS E INACTIVIDADES MILITARES
# ==============================================================================
# Canal donde se despliega el panel en vivo de ausencias y formulario de permisos (Botón "Reportar Ausencia")
CHANNEL_ABSENCES_PANEL=


# ==============================================================================
# 📩 11. SISTEMA DE TICKETS Y ATENCIÓN MILITAR
# ==============================================================================
# ID de la categoría de Discord donde se crearán los canales temporales de tickets
TICKETS_CATEGORY_ID=

# Canal privado donde se guardan las transcripciones completas al cerrar un ticket
TICKETS_TRANSCRIPTS_CHANNEL=
